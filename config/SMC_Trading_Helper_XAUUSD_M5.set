; SMC Trading Helper - 黄金(XAUUSD) M5剥头皮参数
; 适用于MetaTrader 5 指标参数配置
; 创建日期: 2026-03-12
; 说明: M5短线，适合趋势+震荡混合行情

; ============================================
; 周期设置 - M5剥头皮
; ============================================
HigherTimeframe=H1
LowerTimeframe=M5
UseMultiTimeframe=true
RangingMode=false

; ============================================
; 通用设置
; ============================================
LookBackPeriod=150
SwingPeriod=3
LiquidityAreaOpacity=0.15

; ============================================
; 显示开关 - 保持图表干净
; ============================================
ShowEntrySignals=true
ShowLiquidityLines=false
ShowLiquidityZones=false
ShowOrderBlocks=false
ShowFVG=false
ShowLiquidityGrab=true
MaxSignalsToShow=3

; ============================================
; 颜色设置
; ============================================
BullishColor=65280
BearishColor=255

; ============================================
; FVG设置 - 黄金M5适配
; ============================================
FVG_Period=3
FVG_Min_Points=50.0
FVG_Bars_Extends=30

; ============================================
; PinBar设置 - 黄金M5适配
; ============================================
PinBar_ShadowToBody=2.0
PinBar_LookBack=20

; ============================================
; 流动性猎杀设置 - 黄金M5适配
; ============================================
LiquidityGrab_Deviation_Points=150.0
LiquidityGrab_LookForward=4

; ============================================
; 订单区块设置 - 黄金M5适配
; ============================================
OrderBlock_Width_Bars=15
Impulse_Bars_Count=2
