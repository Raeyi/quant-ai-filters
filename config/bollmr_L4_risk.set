;=====================================================================
;           L4: BollMR 风控参数优化
;           前置：L1、L2、L3 最优参数已确定
;           目标：优化资金管理参数
;=====================================================================

;--- 策略选择 ---
StrategyVariant=enhanced

;=====================================================================
;                  【L4 优化参数 - 风控】
;=====================================================================
;--- 仓位控制 ---
InpRiskPercent=1.0 || 1 || 1 || 5

;--- 持仓控制 ---
MaxHoldingBars=5 || 0 || 5 || 30

;--- 连亏保护 ---
MaxLosingStreak=3 || 2 || 1 || 5
CooldownBarsAfter=5 || 3 || 2 || 10

;--- 日亏损限制 ---
MAX_DAILY_LOSS_PERCENT=5.0 || 5.0 || 5.0 || 25

;=====================================================================
;                  【L1+L2+L3 固定参数】
;           >>> 请在 L1、L2、L3 优化后填入最优值 <<<
;=====================================================================
;--- L1 核心策略 ---
BollMR_BollPeriod=18
BollMR_BollDev=2.0
BollMR_ATRPeriod=14
BollMR_StructATRSL=0.8
BollMR_VolATRSL=2.0
BollMR_ATRVolLimit=1.5
BollMR_MidATRTP=0.2
BollMR_MidATRTP2=0.5
BollMR_Slope_Abs=150

;--- L2 时间过滤 ---
BollMR_TimeMode=session
BollMR_Session=europe,us
BollMR_ServerUTCOffset=2
BollMR_UseDST=false
BollMR_DSTShiftHours=1
BollMR_StartHour=2
BollMR_EndHour=20

;--- L3 RF 过滤 ---
RF_Q_Score_Standby=0.30
Regime_ADX_Period=14
Regime_ADX_Trend_Threshold=25.0
Regime_DI_Threshold=3.0
Regime_ATR_Period=14
Regime_Vol_Lookback=100
Regime_Vol_Low_Percentile=25.0
Regime_Vol_High_Percentile=75.0

;=====================================================================
;                  【其他固定参数】
;=====================================================================
;--- RSI ---
BollMR_RSIPeriod=14
BollMR_RSIOverbought=70.0
BollMR_RSIOversold=30.0

;--- 其他 ---
CooldownSeconds=60
BollMR_ShortestClosingTime=10
BollMR_PartialExit1=0.5
BollMR_PartialExit2=0.25
BollMR_UplowATRTP=0.1
BollMR_MAPeriod=50
BollMR_EntryMode=A
BollMR_LogSignalDetails=true
ApplyTemplateOnInit=true
ApplyTemplateOnce=true
ClearTemplateOnceOnRemove=true
TemplateName=zz_bb_rsi.tpl
ForceTimeframeOnInit=true
TargetTimeframe=5
AlertOnTimeframeChange=true
DisableOnTimeframeChange=true
ReloadOnTimeframeChange=false
AutoRevertTimeframe=false
AlertOnOrderOpen=true
AlertOnOrderClose=true
AlertOnOrderFail=true
GapCooldownBars=5
