;=====================================================================
;           L3: Donchian RF 过滤优化
;           前置：L1、L2 最优参数已确定
;           目标：优化 Regime 过滤器参数
;=====================================================================

;--- 策略选择 ---
StrategyVariant=donchian

;=====================================================================
;                  【L3 优化参数 - RF 过滤】
;=====================================================================
;--- Regime Filter ---
RF_Q_Score_Standby=0.30 || 0.20 || 0.05 || 0.50

;--- Regime 指标 ---
Regime_ADX_Period=14 || 10 || 2 || 20
Regime_ADX_Trend_Threshold=25.0 || 20.0 || 2.5 || 35.0
Regime_DI_Threshold=3.0 || 2.0 || 1.0 || 8.0
Regime_Vol_Low_Percentile=25.0 || 15.0 || 5.0 || 35.0
Regime_Vol_High_Percentile=75.0 || 65.0 || 5.0 || 85.0

;--- 市场质量参数（Q_score 计算）---
MQ_Weight_Eff=0.25 || 0.15 || 0.05 || 0.35
MQ_Weight_FBR=0.25 || 0.15 || 0.05 || 0.35
MQ_Weight_ADX=0.20 || 0.10 || 0.05 || 0.30
MQ_Efficiency_Baseline=0.10 || 0.10 || 0.05 || 0.35
MQ_FBR_Baseline=0.40 || 0.30 || 0.05 || 0.55
MQ_ADX_Baseline=25.0 || 20.0 || 2.5 || 35.0

;=====================================================================
;                  【L1+L2 固定参数】
;           >>> 请在 L1、L2 优化后填入最优值 <<<
;=====================================================================
;--- L1 核心策略 ---
Donchian_Period=20
Donchian_EMA_Fast=55
Donchian_EMA_Slow=144
Donchian_ATR_Period=14
Donchian_ATR_SL_Mult=1.5
Donchian_ATR_TP_Mult=2.2
Donchian_ATR_Avg_Period=30
Donchian_ATR_Exp_Ratio=1.0
Donchian_Enable_Trailing=true

;--- L2 时间过滤 ---
Donchian_US_Start_Hour=20
Donchian_US_Start_Min=30
Donchian_US_End_Hour=2
Donchian_US_End_Min=0
Donchian_Enable_Euro=false
Donchian_Enable_Asian=false

;=====================================================================
;                  【其他固定参数】
;=====================================================================
;--- RF 其他固定 ---
Regime_ATR_Period=14
Regime_Vol_Lookback=100

;--- 风控固定 ---
InpRiskPercent=1.0
MaxHoldingBars=0
CooldownSeconds=60
MaxLosingStreak=3
CooldownBarsAfter=5
MAX_DAILY_LOSS_PERCENT=5.0

;--- 其他 ---
Donchian_LogSignalDetails=true
ApplyTemplateOnInit=true
ApplyTemplateOnce=true
ClearTemplateOnceOnRemove=true
TemplateName=zz_bb_rsi.tpl
ForceTimeframeOnInit=true
TargetTimeframe=5
AlertOnTimeframeChange=true
DisableOnTimeframeChange=true
ReloadOnTimeframeChange=false
AutoRevertTimeframe=false
AlertOnOrderOpen=true
AlertOnOrderClose=true
AlertOnOrderFail=true
GapCooldownBars=5
